generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  GUEST
  USER
  MENTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum MentorStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum DemandLevel {
  LOW
  MEDIUM
  HIGH
}

enum ApplicationStatus {
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

enum AIResultType {
  RESUME
  ROADMAP
  INTERVIEW
  SKILL_GAP
  COVER_LETTER
}

enum NotificationType {
  PLATFORM_UPDATE
  AI_USAGE_ALERT
  SECURITY_ALERT
  ADMIN_ANNOUNCEMENT
}

enum NotificationTarget {
  ALL
  USER
  MENTOR
  ADMIN
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ModerationStatus {
  OPEN
  REVIEWED
  RESOLVED
  DISMISSED
}

enum SecuritySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  email           String           @unique
  password        String
  role            Role             @default(USER)
  status          UserStatus       @default(ACTIVE)
  mentorStatus    MentorStatus     @default(NONE)
  permissions     String[]         @default([])
  avatar          String?
  bio             String?
  suspendedAt     DateTime?
  lastActiveAt    DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  profile         Profile?
  jobApplications JobApplication[]
  blogs           Blog[]
  aiResults       AIResult[]
  aiUsageLogs     AIUsageLog[]
  notifications   Notification[]
  reviews         Review[]
  moderationReportsFiled ModerationReport[] @relation("ReportFiledBy")
  moderationReportsTargeted ModerationReport[] @relation("ReportTargetsUser")
  supportTickets SupportTicket[] @relation("SupportTicketUser")
  assignedSupportTickets SupportTicket[] @relation("SupportTicketAssignee")
  securityEvents SecurityEvent[]
}

model Profile {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  education  Json     @default("[]")
  skills     String[] @default([])
  experience Json     @default("[]")
  github     String?
  linkedin   String?
  portfolio  String?
}

model Career {
  id          String      @id @default(uuid()) @db.Uuid
  title       String
  description String
  category    String
  salaryRange String
  location    String
  rating      Float       @default(0.0)
  demandLevel DemandLevel @default(MEDIUM)
  createdAt   DateTime    @default(now())
  reviews     Review[]
}

model JobApplication {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @db.Uuid
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  role        String
  status      ApplicationStatus @default(APPLIED)
  appliedDate DateTime
  notes       String?
  updatedAt   DateTime          @updatedAt

  @@index([userId])
}

model Blog {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  slug      String   @unique
  content   String
  thumbnail String?
  tags      String[] @default([])
  authorId  String   @db.Uuid
  user      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category  String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  reports   ModerationReport[] @relation("ReportTargetsBlog")
}

model AIResult {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AIResultType
  prompt    String
  response  Json
  createdAt DateTime     @default(now())

  @@index([userId, type])
}

model AIUsageLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @db.Uuid
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  feature      String
  tokensUsed   Int      @default(0)
  responseTime Int
  success      Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([createdAt, feature])
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType   @default(PLATFORM_UPDATE)
  roleTarget NotificationTarget @default(ALL)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerId  String?  @db.Uuid
  career    Career?  @relation(fields: [careerId], references: [id], onDelete: Cascade)
  rating    Int
  message   String
  createdAt DateTime @default(now())
}

model ModerationReport {
  id           String           @id @default(uuid()) @db.Uuid
  reporterId   String?          @db.Uuid
  reporter     User?            @relation("ReportFiledBy", fields: [reporterId], references: [id], onDelete: SetNull)
  targetUserId String?          @db.Uuid
  targetUser   User?            @relation("ReportTargetsUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetBlogId String?          @db.Uuid
  targetBlog   Blog?            @relation("ReportTargetsBlog", fields: [targetBlogId], references: [id], onDelete: SetNull)
  reason       String
  description  String?
  status       ModerationStatus @default(OPEN)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  resolvedAt   DateTime?
}

model SupportTicket {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String?        @db.Uuid
  user         User?          @relation("SupportTicketUser", fields: [userId], references: [id], onDelete: SetNull)
  assignedToId String?        @db.Uuid
  assignedTo   User?          @relation("SupportTicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  email        String?
  subject      String
  message      String
  status       SupportStatus  @default(OPEN)
  priority     SupportPriority @default(MEDIUM)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model SecurityEvent {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String?          @db.Uuid
  user       User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  type       String
  severity   SecuritySeverity @default(MEDIUM)
  message    String
  ipAddress  String?
  createdAt  DateTime         @default(now())

  @@index([createdAt, severity])
}
