generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  GUEST
  USER
  MENTOR
  ADMIN
}

enum DemandLevel {
  LOW
  MEDIUM
  HIGH
}

enum ApplicationStatus {
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

enum AIResultType {
  RESUME
  ROADMAP
  INTERVIEW
  SKILL_GAP
  COVER_LETTER
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  email           String           @unique
  password        String
  role            Role             @default(USER)
  avatar          String?
  bio             String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  profile         Profile?
  jobApplications JobApplication[]
  blogs           Blog[]
  aiResults       AIResult[]
  notifications   Notification[]
  reviews         Review[]
}

model Profile {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  education  Json     @default("[]")
  skills     String[] @default([])
  experience Json     @default("[]")
  github     String?
  linkedin   String?
  portfolio  String?
}

model Career {
  id          String      @id @default(uuid()) @db.Uuid
  title       String
  description String
  category    String
  salaryRange String
  location    String
  rating      Float       @default(0.0)
  demandLevel DemandLevel @default(MEDIUM)
  createdAt   DateTime    @default(now())
  reviews     Review[]
}

model JobApplication {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @db.Uuid
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  role        String
  status      ApplicationStatus @default(APPLIED)
  appliedDate DateTime
  notes       String?
  updatedAt   DateTime          @updatedAt

  @@index([userId])
}

model Blog {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  slug      String   @unique
  content   String
  thumbnail String?
  authorId  String   @db.Uuid
  user      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category  String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AIResult {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AIResultType
  prompt    String
  response  Json
  createdAt DateTime     @default(now())

  @@index([userId, type])
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerId  String?  @db.Uuid
  career    Career?  @relation(fields: [careerId], references: [id], onDelete: Cascade)
  rating    Int
  message   String
  createdAt DateTime @default(now())
}
